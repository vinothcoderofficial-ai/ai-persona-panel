# Copy to .env and fill in. Never commit .env.
#
# This file IS read now: envfile.py loads it at import of sim/llm_client.py and
# api/app/db.py. Two rules -- a real environment variable always beats the file,
# and an empty value (like the LLM_API_KEY= below) means "not set" rather than
# "empty string", so it cannot shadow an exported key.

# Which backend sim/llm_client.py talks to: "anthropic" (default) or "ollama".
LLM_PROVIDER=anthropic

# --- anthropic ---
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- ollama ---
# A local daemon needs no key. Leave LLM_BASE_URL unset to use
# http://localhost:11434, or point it at Ollama Cloud and set LLM_API_KEY,
# which is then sent as `Authorization: Bearer ...`.
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b

# Set to 1 to serve persona policies and traces from data/cache/ with no network.
LLM_OFFLINE=0

# Vision service (GPU laptop). Leave blank on CPU machines to use the committed replay.
VISION_URL=

API_PORT=8000
WEB_PORT=5173
DATABASE_URL=sqlite:///./shoppertwin.db
