{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "Event",
  "type": "object",
  "required": ["t_ms", "type", "station_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "t_ms": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": ["gaze", "fixation", "cursor_dwell", "hover", "pickup", "add_to_cart", "remove", "station_enter", "station_exit", "checkout"]
    },
    "station_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
